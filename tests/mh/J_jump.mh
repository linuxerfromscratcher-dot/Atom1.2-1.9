// J (Jump) test: bare J is unconditional, J(n)(1) jumps if true, J(n)(2) if false
D1
O          // 1
J5         // jump to label 5
D99        // skipped
O          // skipped
5:
D2
O          // 2
D3 D4 C
J7(1)      // 3 != 4 -> not taken
D3
O          // 3
J9         // jump to label 9
7:
D8
O          // skipped
9:
D4 D4 C
J11(2)     // 4 == 4 -> not taken
D4
O          // 4
J13        // jump to label 13
11:
D12
O          // skipped
13:
Q
